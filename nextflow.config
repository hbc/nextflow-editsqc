params {

    // Options: Mandatory
    fastq_files                = null //note
    genome_fasta               = null //note
    gene_annotation            = null //note
    plasmid_annotation         = null //note
    plasmid_fasta              = null //note
    outdir                     = "./results"

    single_end                =  true 
    // Options: Config
    multiqc_config             = null

    // Options: Custom config
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null

    // Options: Other
    help                       = false
    max_multiqc_email_size     = '25.MB' //note
    multiqc_title              = null //note
    tracedir                   = "${params.outdir}/pipeline_info"
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = 'genomes'


    // Config options
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
    config_profile_name        = null


    // Max resource options
    // Defaults only, expecting to be overwritten
    max_memory                 = '72.GB'
    max_cpus                   = 6
    max_time                   = '240.h'
}

includeConfig 'conf/module.config'
includeConfig 'conf/base.config'

manifest {
    name = 'nf-core/nextflow-nanopore'
    author = 'Your Name <your.email@example.com>'
    description = 'A simple Nextflow pipeline using nf-core modules'
    version = '1.0.0'
}

profiles {
    test {
        includeConfig 'test.config'
        params {
            // Override max resources for test profile
            max_memory = '6.GB'
            max_cpus = 2
            max_time = '6.h'
        }
    }
    docker {
        docker.enabled         = true
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'
// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

trace.overwrite = true
report.overwrite = true 
dag.overwrite = true
timeline.overwrite = true

timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_\${workflow.start.format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_\${workflow.start.format('yyyy-MM-dd_HH-mm-ss')}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_\${workflow.start.format('yyyy-MM-dd_HH-mm-ss')}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_\${workflow.start.format('yyyy-MM-dd_HH-mm-ss')}.html"
}
